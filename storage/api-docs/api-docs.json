{
    "openapi": "3.0.0",
    "info": {
        "title": "Pengabdian Dosen - Landing Page API",
        "description": "API publik untuk mengambil data konten landing page Program Pengabdian Dosen. Semua endpoint bersifat read-only (GET) dan tidak memerlukan autentikasi.",
        "contact": {
            "name": "Admin",
            "email": "admin@pengabdiandosen.id"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1 Server"
        }
    ],
    "paths": {
        "/about": {
            "get": {
                "tags": [
                    "About Section"
                ],
                "summary": "Daftar About Section aktif",
                "description": "Menampilkan semua about section yang berstatus aktif beserta cards dan points-nya. Digunakan untuk menampilkan konten \"Tentang Program\" di landing page.",
                "operationId": "3a1d372655d014fe77533376ae310e86",
                "responses": {
                    "200": {
                        "description": "Berhasil mengambil data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/AboutSection"
                                            }
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/about/{id}": {
            "get": {
                "tags": [
                    "About Section"
                ],
                "summary": "Detail About Section",
                "description": "Menampilkan detail satu about section berdasarkan ID, termasuk cards dan points-nya.",
                "operationId": "0493a3a1ae0a8336d3ff60b06d4fd11d",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID About Section",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Berhasil mengambil data",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "data": {
                                            "$ref": "#/components/schemas/AboutSection"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Data tidak ditemukan"
                    }
                }
            }
        },
        "/contact": {
            "get": {
                "tags": [
                    "Contact"
                ],
                "summary": "Data Kontak",
                "description": "Menampilkan section kontak yang aktif beserta daftar item kontak (alamat, email, WhatsApp, dll). Hanya mengembalikan 1 section aktif.",
                "operationId": "27825138666a8e10318d78cf196867d2",
                "responses": {
                    "200": {
                        "description": "Berhasil mengambil data",
                        "content": {
                            "application/json": {
